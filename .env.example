# Copy to .env (never commit .env)
OPENAI_API_KEY=your_key_here          # or ANTHROPIC_API_KEY / GEMINI_API_KEY
SERPER_API_KEY=your_serper_key        # https://serper.dev (free tier)
EVSYNC_MODEL=gpt-4o-mini              # cheap model for research agents
EVSYNC_STRATEGIST_MODEL=gpt-4o        # stronger model for the strategist / fact-checker
